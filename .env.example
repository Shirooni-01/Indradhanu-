# ==============================================================================
# Project Indradhanu - Environment Configuration Template
# Copy this file to '.env' and configure for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Central Server & PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/indradhanu
# Set ALLOW_SQLITE_FALLBACK=true only for local testing when PostgreSQL is unavailable
ALLOW_SQLITE_FALLBACK=true

# Shared API key for authenticating edge devices with the central server
CENTRAL_API_KEY=indradhanu-edge-auth-token-change-in-prod

# Central Verification Model Policy
CENTRAL_VERIFY_CONF_THRESHOLD=0.55

# ------------------------------------------------------------------------------
# 2. Village Siren Controller & Alert Policy Configuration
# ------------------------------------------------------------------------------
# Minimum central verification confidence required to trigger the village siren
SIREN_ALERT_CONF_THRESHOLD=0.65
# Maximum acceptable sync delay (seconds) for automatic siren activation
SIREN_MAX_SYNC_DELAY_SEC=300
# Siren operating mode: SAFE_TEST, HARDWARE_HTTP, HARDWARE_GPIO, or DISABLED
SIREN_MODE=SAFE_TEST
SIREN_CONTROLLER_URL=http://127.0.0.1:5050
SIREN_API_KEY=indradhanu-siren-auth-token-change-in-prod
SIREN_GPIO_PIN=23
SIREN_DURATION_SEC=15

# ------------------------------------------------------------------------------
# 3. Edge Device Identity, Camera & Optimization (Raspberry Pi 3 Model B+)
# ------------------------------------------------------------------------------
EDGE_NODE_CODE=NODE-01
EDGE_NODE_NAME=North Perimeter Edge Device
EDGE_SECTOR=Sector 1 (Forest Buffer)
EDGE_LATITUDE=21.1458
EDGE_LONGITUDE=79.0882
FIXED_HEADING_DEG=145

# Central Server URL (Where edge device uploads snapshots and events)
HQ_SERVER_URL=http://127.0.0.1:5000
EDGE_API_KEY=indradhanu-edge-auth-token-change-in-prod

# Camera Source (0 for /dev/video0 on Raspberry Pi, or video/stream path)
CAMERA_SOURCE=0
CONFIDENCE_THRESHOLD=0.55
# Inference image size (320 recommended for Raspberry Pi 3 Model B+ CPU/RAM)
EDGE_IMGSZ=320
EDGE_CPU_THREADS=2

# ------------------------------------------------------------------------------
# 4. Optional SMS Alert Gateway Configuration
# ------------------------------------------------------------------------------
SMS_MODE=SIMULATED_CONSOLE
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GSM_PORT=/dev/ttyUSB0
GSM_BAUDRATE=115200
TEST_MOBILE_NUMBER=
