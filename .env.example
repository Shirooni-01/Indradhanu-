# ==============================================================================
# Project Indradhanu - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials and settings.
# ==============================================================================

# Edge Station Identity & Coordinates
EDGE_NODE_CODE=NODE-01
EDGE_NODE_NAME=Perimeter Surveillance Tower
EDGE_SECTOR=Sector 1 (Perimeter Buffer)
EDGE_LATITUDE=21.1458
EDGE_LONGITUDE=79.0882
FIXED_HEADING_DEG=145

# Central Server / HQ URL
HQ_SERVER_URL=http://127.0.0.1:5000

# Camera Source (0 for /dev/video0 on Raspberry Pi, 1 for phone/virtual cam, or RTSP/HTTP URL)
CAMERA_SOURCE=0
CONFIDENCE_THRESHOLD=0.65

# SMS Alert Gateway Configuration (FAST2SMS, TWILIO, or GSM_MODEM)
SMS_MODE=FAST2SMS

# Fast2SMS Provider (India quick SMS API - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Provider (Global SMS - https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# GSM Hardware Modem (Optional fallback via USB serial SIM800/SIM900)
GSM_PORT=/dev/ttyUSB0
GSM_BAUDRATE=115200

# Verification recipient for manual / test SMS
TEST_MOBILE_NUMBER=+91XXXXXXXXXX
